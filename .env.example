# ===========================
# OfferPilot Lite 环境配置
# 复制为 .env 后修改
# ===========================

# --- 官方 DeepSeek 文本模型接口 ---
OFFERPILOT_OPENAI_API_KEY=
OFFERPILOT_OPENAI_BASE_URL=https://api.deepseek.com
OFFERPILOT_OPENAI_MODEL=deepseek-flash

# --- MiMo 语音转写 ---
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_ASR_MODEL=mimo-v2.5-asr

# --- 服务地址 ---
API_PORT=8000
WEB_PORT=3000

# --- 数据库 ---
OFFERPILOT_SQLITE_PATH=./data/offerpilot.db
OFFERPILOT_ADMIN_KEY=change-me-before-enabling-reindex

# --- 匿名 Profile 与浏览器边界 ---
# 生产环境必须设置为至少 32 字节的随机值；不要提交真实密钥。
OFFERPILOT_PROFILE_SIGNING_KEY=replace-with-a-random-secret-of-at-least-32-bytes
OFFERPILOT_CORS_ORIGINS=http://localhost:3000
# 仅本地 HTTP 调试时设为 true；它会输出易读文本日志并禁用 Cookie Secure 属性。
# 生产部署必须设为 false，使用 HTTPS 来源与 TLS 终端；日志会改为 JSON。
OFFERPILOT_DEBUG=true
# --- 运行资源目录 ---
OFFERPILOT_KNOWLEDGE_DIR=./resources/knowledge
OFFERPILOT_RULES_DIR=./resources/rules

# --- Embedding 语义检索（OpenAI-compatible，独立于文本模型） ---
OFFERPILOT_EMBEDDING_API_KEY=
OFFERPILOT_EMBEDDING_BASE_URL=
OFFERPILOT_EMBEDDING_MODEL=text-embedding-3-small
OFFERPILOT_EMBEDDING_TIMEOUT_SECONDS=30
OFFERPILOT_REQUIRE_EMBEDDING=true

# --- 日志 ---
# 仅接受 DEBUG、INFO、WARNING、ERROR。DEBUG/INFO 写 stdout，WARNING/ERROR 写 stderr。
OFFERPILOT_LOG_LEVEL=info

# --- Docker 环境变量 ---
# Web 在浏览器端无法访问容器内部地址，Docker 部署时使用 service name
API_BASE_URL=http://api:8000
