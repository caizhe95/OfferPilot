# ===========================
# OfferPilot Lite 环境配置
# 复制为 .env 后修改
# ===========================

# --- OpenAI 兼容接口 ---
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# --- ASR 语音转写 ---
ASR_PROVIDER=openai
ASR_MODEL=whisper-1

# --- 服务地址 ---
API_HOST=0.0.0.0
API_PORT=8000
AGENT_PORT=3001
WEB_PORT=3000

# --- 数据库 ---
SQLITE_PATH=./data/offerpilot.db

# --- 知识库目录 ---
KNOWLEDGE_DIR=./knowledge/selected

# --- 日志 ---
LOG_LEVEL=info
DEBUG=false

# --- Docker 环境变量 ---
# Web 在浏览器端无法访问容器内部地址，Docker 部署时使用 service name
API_BASE_URL=http://api:8000
AGENT_BASE_URL=http://agent:3001
