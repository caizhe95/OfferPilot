# ===========================
# OfferPilot Lite 环境配置
# 复制为 .env 后修改
# ===========================

# --- OpenAI-compatible 文本模型接口 ---
OFFERPILOT_OPENAI_API_KEY=
OFFERPILOT_OPENAI_BASE_URL=https://your-text-gateway.example/v1
OFFERPILOT_OPENAI_MODEL=

# --- MiMo 语音转写 ---
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_ASR_MODEL=mimo-v2.5-asr

# --- 服务地址 ---
OFFERPILOT_API_HOST=0.0.0.0
OFFERPILOT_API_PORT=8000
WEB_PORT=3000

# --- 数据库 ---
OFFERPILOT_SQLITE_PATH=./data/offerpilot.db
OFFERPILOT_ADMIN_KEY=change-me-before-enabling-reindex

# --- 知识库目录 ---
OFFERPILOT_KNOWLEDGE_DIR=./knowledge

# --- Embedding 语义检索（OpenAI-compatible，独立于文本模型） ---
OFFERPILOT_EMBEDDING_PROVIDER=openai-compatible
OFFERPILOT_EMBEDDING_API_KEY=
OFFERPILOT_EMBEDDING_BASE_URL=
OFFERPILOT_EMBEDDING_MODEL=text-embedding-3-small
OFFERPILOT_EMBEDDING_TIMEOUT_SECONDS=30
OFFERPILOT_REQUIRE_EMBEDDING=true

# --- 日志 ---
OFFERPILOT_LOG_LEVEL=info
OFFERPILOT_DEBUG=false

# --- Docker 环境变量 ---
# Web 在浏览器端无法访问容器内部地址，Docker 部署时使用 service name
API_BASE_URL=http://api:8000
